---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import ProjectsIndexPage from '../../components/ProjectsIndexPage.astro'
import { getProjects } from '../../lib/projects'
import { projectListSchema, projectsIndexSchema } from '../../lib/seo'
const projects = await getProjects()
---
<BaseLayout locale="zh-CN" title="工具链项目 | weapp.dev" description="weapp.dev 五层核心工具链与 uni-app 生态伙伴" imageAlt="weapp.dev 五层核心工具链项目地图" schemas={[projectsIndexSchema('zh-CN', projects), projectListSchema('zh-CN', projects)]}><Header locale="zh-CN" projects={projects} currentPath={Astro.url.pathname} /><ProjectsIndexPage locale="zh-CN" projects={projects} /><Footer locale="zh-CN" projects={projects} currentPath={Astro.url.pathname} /></BaseLayout>
